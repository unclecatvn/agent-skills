{
  "$schema": "https://json.schemastore.org/claude-plugin.json",
  "name": "odoo-agents",
  "version": "0.1.0",
  "description": "Odoo-focused skills, OWL frontend guides, and helper agents for AI coding assistants",
  "author": "milzamsz",
  "license": "MIT",
  "homepage": "https://github.com/milzamsz/odoo-agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/milzamsz/odoo-agents.git"
  },
  "components": {
    "agents": [
      "agents/odoo-code-review/SKILL.md",
      "agents/odoo-code-tracer/SKILL.md"
    ],
    "skills": [
      "skills/brainstorming/SKILL.md",
      "skills/code-review/SKILL.md",
      "skills/dtg-base/SKILL.md",
      "skills/mcp-builder/SKILL.md",
      "skills/odoo-18.0/SKILL.md",
      "skills/odoo-19.0/SKILL.md",
      "skills/odoo-owl/SKILL.md",
      "skills/odoo-owl-testing/SKILL.md",
      "skills/odoo-webclient-extension/SKILL.md",
      "skills/payment-integration/SKILL.md",
      "skills/writing-skills/SKILL.md"
    ],
    "rules": [
      "rules/coding-style.md",
      "rules/security.md"
    ]
  },
  "capabilities": {
    "memoryPersistence": true,
    "sessionLifecycle": true,
    "crossPlatform": true
  }
}
